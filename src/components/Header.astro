---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const { hasSidebar } = Astro.locals.starlightRoute;
const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<script is:inline>
  const choiceKey = 'resources:sidebar-choice';
  const initialKey = 'resources:sidebar-initial-hidden';
  let choice;
  let initial;
  try {
    choice = localStorage.getItem(choiceKey);
    initial = sessionStorage.getItem(initialKey);
  } catch {}
  if (choice !== 'shown' && choice !== 'hidden' && initial == null) {
    const width = window.innerWidth;
    const ratio = width / Math.max(window.innerHeight, 1);
    const halfScreen = screen.availWidth > 0 && width <= screen.availWidth / 2;
    initial = String(width < 800 || ratio < 1.55 || halfScreen);
    try {
      sessionStorage.setItem(initialKey, initial);
    } catch {}
  }
  document.documentElement.toggleAttribute(
    'data-sidebar-hidden',
    choice === 'hidden' || (choice !== 'shown' && initial === 'true')
  );
</script>

<div class="header">
  <div class="title-wrapper sl-flex">
    {
      hasSidebar && (
        <button
          id="desktop-sidebar-toggle"
          class="sidebar-toggle print:hidden"
          type="button"
          aria-controls="starlight__sidebar"
          aria-expanded="true"
          aria-label="좌측 내비게이션 숨기기"
          title="좌측 내비게이션 숨기기"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
            <path d="M9 4v16"></path>
            <path class="toggle-arrow" d="m14 9-3 3 3 3"></path>
          </svg>
        </button>
      )
    }
    <SiteTitle />
  </div>
  <div class="sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<script>
  const storageKey = 'resources:sidebar-choice';
  const groupStorageKey = 'resources:foodtech-open-groups';
  const button = document.querySelector<HTMLButtonElement>('#desktop-sidebar-toggle');

  const restoreFoodtechGroups = () => {
    const foodtech = [...document.querySelectorAll<HTMLDetailsElement>('#starlight__sidebar details')]
      .find((group) => group.querySelector(':scope > summary .group-label')?.textContent?.trim() === 'Foodtech AI Recipe Agent');
    const groups = [...(foodtech?.querySelectorAll<HTMLDetailsElement>(':scope > ul > li > details') ?? [])];
    let saved: string[] = [];
    try {
      const parsed = JSON.parse(sessionStorage.getItem(groupStorageKey) ?? '[]');
      if (Array.isArray(parsed)) saved = parsed.filter((item): item is string => typeof item === 'string');
    } catch {}

    for (const group of groups) {
      const label = group.querySelector(':scope > summary .group-label')?.textContent?.trim();
      if (!label) continue;
      group.open = saved.includes(label);
      group.addEventListener('toggle', () => {
        const open = groups
          .filter((item) => item.open)
          .map((item) => item.querySelector(':scope > summary .group-label')?.textContent?.trim())
          .filter((item): item is string => Boolean(item));
        try {
          sessionStorage.setItem(groupStorageKey, JSON.stringify(open));
        } catch {}
      });
    }
  };

  const updateButton = () => {
    if (!button) return;
    const hidden = document.documentElement.hasAttribute('data-sidebar-hidden');
    const label = hidden ? '좌측 내비게이션 펼치기' : '좌측 내비게이션 숨기기';
    button.setAttribute('aria-expanded', String(!hidden));
    button.setAttribute('aria-label', label);
    button.title = label;
  };

  const setHidden = (hidden: boolean) => {
    document.documentElement.toggleAttribute('data-sidebar-hidden', hidden);
    try {
      localStorage.setItem(storageKey, hidden ? 'hidden' : 'shown');
    } catch {}
    updateButton();
  };

  button?.addEventListener('click', () => {
    setHidden(!document.documentElement.hasAttribute('data-sidebar-hidden'));
  });

  window.addEventListener('storage', (event) => {
    if (event.key === storageKey && event.newValue) {
      document.documentElement.toggleAttribute('data-sidebar-hidden', event.newValue === 'hidden');
      updateButton();
    }
  });

  updateButton();
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', restoreFoodtechGroups, { once: true });
  else restoreFoodtechGroups();
</script>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }

    .title-wrapper {
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
      align-items: center;
      gap: 0.55rem;
    }

    .sidebar-toggle {
      display: none;
      flex: 0 0 auto;
      width: 2.25rem;
      height: 2.25rem;
      place-items: center;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.5rem;
      background: transparent;
      color: var(--sl-color-gray-2);
      cursor: pointer;
    }

    .sidebar-toggle:hover {
      border-color: var(--sl-color-gray-3);
      color: var(--sl-color-white);
    }

    .sidebar-toggle:focus-visible {
      outline: 2px solid var(--sl-color-accent);
      outline-offset: 2px;
    }

    .sidebar-toggle svg {
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.8;
    }

    :global(html[data-sidebar-hidden]) .toggle-arrow {
      transform: translateX(1px) rotate(180deg);
      transform-origin: center;
    }

    .right-group,
    .social-icons {
      gap: 1rem;
      align-items: center;
    }

    .social-icons::after {
      content: '';
      height: 2rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
    }

    @media (min-width: 50rem) {
      .sidebar-toggle {
        display: grid;
      }

      :global(:root[data-has-sidebar]) {
        --__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
      }

      :global(:root:not([data-has-toc])) {
        --__toc-width: 0rem;
      }

      .header {
        --__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
        --__main-column-fr: calc(
          (
              100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
                (2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
                var(--sl-content-width)
            ) / 2
        );
        display: grid;
        grid-template-columns:
          minmax(
            calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
            auto
          )
          1fr
          auto;
        align-content: center;
      }
    }
  }
</style>
