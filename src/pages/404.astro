---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const frontmatter = {
  title: '페이지를 찾을 수 없습니다',
  template: 'splash',
  editUrl: false,
  pagefind: false,
};
---

<StarlightPage {frontmatter}>
  <p>
    요청한 페이지가 없거나 경로가 바뀌었습니다. 사이트 첫 화면이나
    사이드바에서 자료를 다시 찾아주세요.
  </p>
</StarlightPage>
