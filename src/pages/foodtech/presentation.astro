---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const slideCount = 12;
const slideBase = `${base}foodtech/presentation/slides/`;
const deckUrl = `${base}foodtech/files/Foodtech_AI_Recipe_Agent_03_레시피_가상_시나리오와_Mock_연계_v0.2.pptx`;
const planSlideBase = `${base}foodtech/presentation/01/`;
const planDeckUrl = `${base}foodtech/files/Foodtech_AI_Recipe_Agent_01_프로젝트_소개와_개발_계획_v0.2.pptx`;
const dataSlideBase = `${base}foodtech/presentation/02/`;
const dataDeckUrl = `${base}foodtech/files/Foodtech_AI_Recipe_Agent_02_데이터와_수집_v0.2.pptx`;
const aiSlideBase = `${base}foodtech/presentation/04/`;
const aiDeckUrl = `${base}foodtech/files/Foodtech_AI_Recipe_Agent_04_AI와_레시피_v0.1.pptx`;
const systemSlideBase = `${base}foodtech/presentation/05/`;
const systemDeckUrl = `${base}foodtech/files/Foodtech_AI_Recipe_Agent_05_시스템_설계와_개발_화면과_운영_v0.1.pptx`;
const resourcesUrl = `${base}foodtech/files/`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Foodtech AI Recipe Agent의 대표 레시피 가상 시나리오와 Mock 연계를 설명하는 발표 자료"
    />
    <title>레시피 가상 시나리오와 Mock 연계</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: "Noto Sans KR", "Noto Sans CJK KR", system-ui, sans-serif;
        background: #071522;
        color: #f7f9fc;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-width: 320px;
        min-height: 100vh;
        margin: 0;
        background:
          radial-gradient(circle at top, rgb(21 151 165 / 16%), transparent 34rem),
          #071522;
      }

      button,
      a {
        font: inherit;
      }

      a {
        color: inherit;
      }

      .toolbar {
        display: grid;
        grid-template-columns: minmax(10rem, 1fr) minmax(18rem, 2fr) minmax(10rem, 1fr);
        align-items: center;
        gap: 1rem;
        min-height: 4.25rem;
        padding: 0.75rem clamp(1rem, 3vw, 2.5rem);
        border-bottom: 1px solid rgb(255 255 255 / 10%);
        background: rgb(7 21 34 / 86%);
        backdrop-filter: blur(12px);
      }

      .toolbar h1 {
        overflow: hidden;
        margin: 0;
        color: #f7f9fc;
        font-size: clamp(1rem, 2vw, 1.35rem);
        text-align: center;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .toolbar-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.6rem;
      }

      .link-button,
      .control-button {
        display: inline-flex;
        min-height: 2.65rem;
        align-items: center;
        justify-content: center;
        padding: 0.55rem 0.9rem;
        border: 1px solid rgb(255 255 255 / 18%);
        border-radius: 0.65rem;
        background: rgb(255 255 255 / 7%);
        color: #e6ecf2;
        text-decoration: none;
        cursor: pointer;
      }

      .link-button:hover,
      .control-button:hover,
      .link-button:focus-visible,
      .control-button:focus-visible {
        border-color: #78d1d6;
        background: rgb(21 151 165 / 20%);
        outline: none;
      }

      .viewer {
        width: min(100%, 110rem);
        margin: 0 auto;
        padding: clamp(1rem, 3vw, 2.5rem);
      }

      .stage {
        position: relative;
        display: grid;
        aspect-ratio: 16 / 9;
        width: 100%;
        margin-inline: auto;
        place-items: center;
        overflow: hidden;
        border: 1px solid rgb(255 255 255 / 12%);
        border-radius: 0.8rem;
        background: #000;
        box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 35%);
      }

      .stage:focus-visible {
        outline: 3px solid #78d1d6;
        outline-offset: 3px;
      }

      .slide-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        user-select: none;
        -webkit-user-drag: none;
      }

      .slide-nav {
        position: absolute;
        top: 0;
        bottom: 0;
        width: min(12vw, 8rem);
        border: 0;
        background: transparent;
        color: transparent;
        cursor: pointer;
      }

      .slide-nav:hover,
      .slide-nav:focus-visible {
        background: linear-gradient(90deg, rgb(0 0 0 / 35%), transparent);
        color: #fff;
        outline: none;
      }

      .slide-nav::after {
        font-size: clamp(2rem, 5vw, 4rem);
        opacity: 0.8;
      }

      .previous {
        left: 0;
      }

      .previous::after {
        content: "‹";
      }

      .next {
        right: 0;
      }

      .next:hover,
      .next:focus-visible {
        background: linear-gradient(270deg, rgb(0 0 0 / 35%), transparent);
      }

      .next::after {
        content: "›";
      }

      .counter {
        position: absolute;
        right: 1rem;
        bottom: 0.8rem;
        min-width: 4.5rem;
        padding: 0.35rem 0.65rem;
        border-radius: 999px;
        background: rgb(7 21 34 / 76%);
        color: #fff;
        font-variant-numeric: tabular-nums;
        text-align: center;
      }

      .help {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem 1.5rem;
        margin: 1rem 0 0;
        color: #9fb1c2;
        font-size: 0.92rem;
      }

      .help kbd {
        padding: 0.15rem 0.4rem;
        border: 1px solid rgb(255 255 255 / 20%);
        border-radius: 0.3rem;
        background: rgb(255 255 255 / 7%);
        color: #dfe8f0;
        font-family: inherit;
      }

      .stage:fullscreen {
        width: 100vw;
        height: 100vh;
        border: 0;
        border-radius: 0;
      }

      @media (min-width: 52rem) {
        .stage {
          width: min(100%, calc((100dvh - 12rem) * 16 / 9));
        }
      }

      @media (max-width: 52rem) {
        .toolbar {
          grid-template-columns: 1fr auto;
        }

        .toolbar h1 {
          grid-column: 1 / -1;
          grid-row: 2;
          text-align: left;
        }

        .toolbar-actions {
          grid-column: 2;
          grid-row: 1;
        }

        .download-label {
          display: none;
        }

        .viewer {
          padding: 1rem 0.75rem;
        }
      }
    </style>
  </head>
  <body>
    <header class="toolbar">
      <a class="link-button" href={resourcesUrl}>← 자료실</a>
      <h1 id="presentation-title">레시피 가상 시나리오와 Mock 연계</h1>
      <div class="toolbar-actions">
        <a class="link-button" id="deck-download" href={deckUrl} download>
          <span class="download-label">원본 </span>PPTX
        </a>
        <button class="control-button" id="fullscreen" type="button">전체 화면</button>
      </div>
    </header>

    <main class="viewer">
      <section
        class="stage"
        id="stage"
        tabindex="0"
        aria-label="발표 슬라이드"
        data-slide-base={slideBase}
        data-slide-count={slideCount}
        data-plan-slide-base={planSlideBase}
        data-plan-slide-count="11"
        data-plan-deck-url={planDeckUrl}
        data-data-slide-base={dataSlideBase}
        data-data-slide-count="16"
        data-data-deck-url={dataDeckUrl}
        data-ai-slide-base={aiSlideBase}
        data-ai-slide-count="17"
        data-ai-deck-url={aiDeckUrl}
        data-system-slide-base={systemSlideBase}
        data-system-slide-count="22"
        data-system-deck-url={systemDeckUrl}
      >
        <img
          class="slide-image"
          id="slide-image"
          src={`${slideBase}slide-1.png`}
          alt={`발표 슬라이드 1 / ${slideCount}`}
          width="1600"
          height="900"
          draggable="false"
        />
        <button class="slide-nav previous" id="previous" type="button" aria-label="이전 슬라이드"></button>
        <button class="slide-nav next" id="next" type="button" aria-label="다음 슬라이드"></button>
        <output class="counter" id="counter" aria-live="polite">1 / {slideCount}</output>
      </section>
      <p class="help">
        <span><kbd>←</kbd> <kbd>→</kbd> 또는 <kbd>Space</kbd>로 이동</span>
        <span><kbd>F</kbd> 전체 화면 · <kbd>Home</kbd> 처음 · <kbd>End</kbd> 마지막</span>
      </p>
    </main>

    <script>
      const stage = document.querySelector('#stage');
      const image = document.querySelector('#slide-image');
      const counter = document.querySelector('#counter');
      const previous = document.querySelector('#previous');
      const next = document.querySelector('#next');
      const fullscreen = document.querySelector('#fullscreen');
      const title = document.querySelector('#presentation-title');
      const download = document.querySelector('#deck-download');

      if (
        stage instanceof HTMLElement &&
        image instanceof HTMLImageElement &&
        counter instanceof HTMLOutputElement &&
        previous instanceof HTMLButtonElement &&
        next instanceof HTMLButtonElement &&
        fullscreen instanceof HTMLButtonElement
      ) {
        const deckId = new URLSearchParams(window.location.search).get('deck');
        const selectedDeck = deckId === '01'
          ? { title: '프로젝트 소개 및 개발 계획', base: stage.dataset.planSlideBase, count: stage.dataset.planSlideCount, url: stage.dataset.planDeckUrl }
          : deckId === '02'
            ? { title: '데이터와 수집', base: stage.dataset.dataSlideBase, count: stage.dataset.dataSlideCount, url: stage.dataset.dataDeckUrl }
            : deckId === '04'
              ? { title: 'AI와 레시피', base: stage.dataset.aiSlideBase, count: stage.dataset.aiSlideCount, url: stage.dataset.aiDeckUrl }
              : deckId === '05'
                ? { title: '시스템 설계와 개발·화면과 운영', base: stage.dataset.systemSlideBase, count: stage.dataset.systemSlideCount, url: stage.dataset.systemDeckUrl }
                : null;
        const slideBase = selectedDeck?.base ?? stage.dataset.slideBase ?? '';
        const slideCount = Number(selectedDeck?.count ?? stage.dataset.slideCount ?? '1');
        if (selectedDeck) {
          document.title = selectedDeck.title;
          if (title) title.textContent = selectedDeck.title;
          if (download instanceof HTMLAnchorElement) download.href = selectedDeck.url ?? '';
        }
        const hashMatch = window.location.hash.match(/^#slide-(\d+)$/);
        let current = Math.min(Math.max(Number(hashMatch?.[1] ?? 1), 1), slideCount);
        let touchStartX = 0;

        const preload = (number) => {
          if (number < 1 || number > slideCount) return;
          const nextImage = new Image();
          nextImage.src = `${slideBase}slide-${number}.png`;
        };

        const show = (number, updateHash = true) => {
          current = Math.min(Math.max(number, 1), slideCount);
          image.src = `${slideBase}slide-${current}.png`;
          image.alt = `발표 슬라이드 ${current} / ${slideCount}`;
          counter.value = `${current} / ${slideCount}`;
          previous.disabled = current === 1;
          next.disabled = current === slideCount;
          if (updateHash) history.replaceState(null, '', `#slide-${current}`);
          preload(current + 1);
        };

        const toggleFullscreen = async () => {
          if (document.fullscreenElement) {
            await document.exitFullscreen();
          } else {
            await stage.requestFullscreen();
          }
        };

        previous.addEventListener('click', () => show(current - 1));
        next.addEventListener('click', () => show(current + 1));
        fullscreen.addEventListener('click', toggleFullscreen);

        document.addEventListener('fullscreenchange', () => {
          fullscreen.textContent = document.fullscreenElement ? '전체 화면 종료' : '전체 화면';
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowRight' || event.key === 'PageDown' || (event.key === ' ' && !event.shiftKey)) {
            event.preventDefault();
            show(current + 1);
          } else if (event.key === 'ArrowLeft' || event.key === 'PageUp' || (event.key === ' ' && event.shiftKey)) {
            event.preventDefault();
            show(current - 1);
          } else if (event.key === 'Home') {
            event.preventDefault();
            show(1);
          } else if (event.key === 'End') {
            event.preventDefault();
            show(slideCount);
          } else if (event.key.toLowerCase() === 'f') {
            event.preventDefault();
            void toggleFullscreen();
          }
        });

        stage.addEventListener('touchstart', (event) => {
          touchStartX = event.changedTouches[0]?.clientX ?? 0;
        }, { passive: true });

        stage.addEventListener('touchend', (event) => {
          const touchEndX = event.changedTouches[0]?.clientX ?? touchStartX;
          const distance = touchEndX - touchStartX;
          if (Math.abs(distance) < 50) return;
          show(distance < 0 ? current + 1 : current - 1);
        }, { passive: true });

        show(current, false);
      }
    </script>
  </body>
</html>
